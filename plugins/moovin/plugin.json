{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "moovin",
  "version": "0.2.1",
  "description": "Use seu assistente de IA para consultar e atualizar informações na Moovin.",
  "author": {
    "name": "Moovin",
    "url": "https://github.com/moovin-labs"
  },
  "homepage": "https://github.com/moovin-labs/agent-toolkit",
  "repository": "https://github.com/moovin-labs/agent-toolkit",
  "keywords": ["moovin", "mcp", "atendimento", "integracoes"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Moovin",
        "shortDescription": "Moovin no seu assistente",
